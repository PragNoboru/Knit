# Knit environment variables (PRD 18.1).
# Copy to .env.local for local development. Never commit real values.
# The server refuses to start if any of these is missing or malformed.

# Supabase. Locally: the values printed by `pnpm supabase start` (from M1).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The anon or publishable key. It is sent to browsers, so never put the
# service-role or secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service-role or secret key. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Google service account key file, base64-encoded (PRD 7.4). Server only.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Id of the Knit folder in Google Drive (from its URL).
KNIT_DRIVE_FOLDER_ID=
# Id of the Knit Archive sheet (from its URL).
KNIT_ARCHIVE_SHEET_ID=

# Long random string, at least 32 characters. The same value goes into
# Supabase Vault as knit_cron_secret (PRD 18.2).
KNIT_CRON_SECRET=
# Base URL of the app, without a trailing slash.
APP_URL=http://localhost:3000
